# LLM provider is backend-only (not shown in the dashboard): nvidia (default) or llama-cpp
LLM_PROVIDER=nvidia

# Hosted NVIDIA provider
NVIDIA_API_KEY=replace_with_your_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NEMOTRON_REASONING_EFFORT=low
NEMOTRON_MAX_TOKENS=8192

# Data source: smard (live) or demo (synthetic CSV)
PRICE_SOURCE=smard

# Agent/API settings
AGENT_MAX_STEPS=0
AGENT_MAX_RUNTIME_SECONDS=900
MAX_CONCURRENT_AGENT_RUNS=2
CHAT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
