# Force LF line endings so text files work consistently across
# Windows checkouts and Linux/Docker containers
*.sh       text eol=lf
*.py       text eol=lf
*.env      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.txt      text eol=lf
*.md       text eol=lf
*.csv      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.template text eol=lf
*.ini      text eol=lf
Dockerfile text eol=lf
