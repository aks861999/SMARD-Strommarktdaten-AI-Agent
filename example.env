# ── LLM: hosted NVIDIA NIM ───────────────────────────────────────
# LLM_PROVIDER is backend-only (not shown in the dashboard): nvidia (default) or llama-cpp.
# docker compose always uses nvidia.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=replace_with_your_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NEMOTRON_REASONING_EFFORT=low
NEMOTRON_MAX_TOKENS=8192

# ── Prices (services/prices) ─────────────────────────────────────
# smard = live data from smard.de, demo = synthetic CSV (no network needed)
PRICE_SOURCE=smard

# ── Agent API (services/api) ─────────────────────────────────────
AGENT_MAX_STEPS=0
AGENT_MAX_RUNTIME_SECONDS=900
MAX_CONCURRENT_AGENT_RUNS=2
# Browser origins allowed to call the API when running it directly (not needed with docker compose,
# where the page and /api share one address).
CHAT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting (all optional; 0 turns a limit off). See the README section "Rate limiting".
# RATE_LIMIT_PER_MINUTE=6
# RATE_LIMIT_PER_HOUR=60
# RATE_LIMIT_GLOBAL_PER_HOUR=300
# RATE_LIMIT_MAX_ACTIVE_PER_IP=1
# Behind a proxy such as Render: header carrying the visitor IP. Leave unset when running locally.
# CLIENT_IP_HEADER=cf-connecting-ip

# ── Webapp (services/webapp, docker compose only) ────────────────
# Host port of the nginx webapp.
WEBAPP_PORT=8080
# API the nginx proxies /api to, and the DNS resolver it uses for it. 127.0.0.11 is Docker's embedded
# resolver; change only for non-Compose deployments.
# WEBAPP_API_URL=http://api:8000
# WEBAPP_DNS_RESOLVER=127.0.0.11
